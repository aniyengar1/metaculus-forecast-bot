# =============================================================================
# Metaculus bot environment variables
#
# How to use:
#   1) Copy this file to `.env` in the same directory.
#        cp .env.template .env
#   2) Replace each `REPLACE_ME` below with your real key.
#   3) Save. The bot will read `.env` automatically on startup.
#
# In GitHub Actions, do NOT commit your `.env`. Instead, add each variable
# under Settings → Secrets and variables → Actions → New repository secret.
# =============================================================================


# ---- REQUIRED -----------------------------------------------------------------
# Your Metaculus bot account token. Without this, the bot cannot read questions
# or post forecasts. Get one at: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME


# ---- LLM PROVIDERS (set at least ONE) -----------------------------------------
# Primary providers as of 2026-10-12 -- Gemini and Groq both have genuinely
# free tiers (no card required) and are tried before the OpenRouter :free
# pool, which is kept only as a fallback (see metaculus_bot/config.py).
#
# Gemini: https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=REPLACE_ME
# Groq: https://console.groq.com/keys (free tier, no card)
GROQ_API_KEY=REPLACE_ME
#
# OpenRouter: fallback tier only. Free credits via the Metaculus tournament:
#   Free credits form: https://forms.gle/aQdYMq9Pisrf1v7d8
#   Get a key:         https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_ME

# Optional alternatives — uncomment the ones you want to use.
# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME


# ---- SEARCH / RESEARCH PROVIDERS (all optional) -------------------------------
# Improves research quality. The bot will fall back to LLM-only research
# if none of these are set.
#
# AskNews: https://asknews.app/
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
#
# Perplexity: https://docs.perplexity.ai/
# PERPLEXITY_API_KEY=REPLACE_ME
#
# Exa: https://exa.ai/
# EXA_API_KEY=REPLACE_ME


# ---- INTEGRATIONS (optional) --------------------------------------------------
# See integrations/README.md for details.
# LightningRod: https://lightningrod.ai/
# LIGHTNINGROD_API_KEY=REPLACE_ME


# ---- BOT ENSEMBLE / BUDGET CONFIG (all optional, see metaculus_bot/config.py) --
# The primary ensemble is slot-based (one model per slot: Gemini,
# gpt-oss-120b, qwen3.8-27b -- see DEFAULT_MODEL_SLOTS in config.py) and not
# env-overridable as of 2026-10-30. Only the OpenRouter :free fallback pool
# (used when a slot's own candidate(s) are all unhealthy) is configurable
# here:
# BOT_OPENROUTER_FALLBACK_POOL=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/apodex/apodex-1.1-mini:free
# BOT_TARGET_ENSEMBLE_SIZE=3
# BOT_N_RUNS=3
# Separate (lighter-weight) pool for the parser/summarizer role.
# BOT_PARSER_MODEL_POOL=gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-20b

# Hard $ budget guard -- estimated from token counts, question is skipped
# (and logged) rather than forecast if either cap would be exceeded. Stays
# at $0 in practice while every model in the pool is free-tier.
# MAX_COST_PER_QUESTION=0.40
# MAX_COST_PER_DAY=10.0

# Daily question throttle is now computed dynamically from real remaining
# per-provider quota each run (metaculus_bot/provider_quota.py, 20% margin).
# This is just the hard ceiling that computed value can never exceed.
# MAX_QUESTIONS_PER_DAY_CEILING=20

# AskNews: "latest news" calls only (never the 5x-cost historical/archive
# endpoint), capped per-question and tracked monthly in SQLite against the
# tournament's 1k/month allowance.
# ASKNEWS_MAX_CALLS_PER_QUESTION=2
# ASKNEWS_MONTHLY_CAP=1000

# Calibration hook applied to the final binary probability before submission.
# k=1.0 is identity; tune later against our own resolved questions.
# CALIBRATION_K=1.0
# CALIBRATION_CLIP_MIN=0.02
# CALIBRATION_CLIP_MAX=0.98

# BOT_DB_PATH=data/forecasts.db
